# Optional local Compose settings. docker compose up --build -d needs no .env.
APP_PORT=8080
APP_PUBLIC_URL=http://127.0.0.1:8080
APP_ENV=development
DEMO_MODE=true

# No token is needed for the local demo. Never commit real secrets.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=local-webhook-test-only
MAX_API_BASE_URL=https://platform-api2.max.ru
AUTH_MAX_AGE_SECONDS=3600
SESSION_TTL_SECONDS=3600

# Native C++ execution only. Compose supplies its internal db hostname.
# Compose does not publish PostgreSQL; a native app needs a separate local DB.
DATABASE_URL=postgresql://app:local-development-only@127.0.0.1:5432/max_help
PORT=8080
DATA_DIR=./data
MIGRATIONS_DIR=./db/migrations
STATIC_DIR=./apps/miniapp/dist

# Public MAX deployment: use compose.pilot.yaml + scripts/prepare-pilot.mjs.
# Do not publish the demo Compose; see docs/DEPLOYMENT.md.
MAX_DELIVERY_ENABLED=true

# Product alerts are opt-in per account and disabled globally until MAX acceptance.
MAX_PRODUCT_NOTIFICATIONS_ENABLED=false

# Numeric MAX IDs of assigned moderators; allowlist applies only to closed mode.
# Empty disables moderator access. Demo accounts can never become moderators.
MODERATOR_MAX_IDS=
