# Reference only. Prefer scripts/prepare-pilot.mjs to generate .env.pilot.local.
# Interactive setup: node scripts/prepare-pilot.mjs --prompt
# Put MAX_BOT_TOKEN in ignored .env.max.local with a local editor first.
# --prompt asks for public settings only; the token is never prompted or printed.
# Also supply the official CA bundle at private/max-ca.pem before setup.
# This file has NO real credentials. Never reuse example passwords.
APP_ENV=production
DEMO_MODE=false
# Public access still requires a real MAX session. Set true for an explicit closed pilot.
PILOT_MODE=false
APP_PUBLIC_URL=https://pilot.example.org
PILOT_PORT=8085
# Used only with PILOT_MODE=true; empty then denies everyone. Ignored in public mode.
# Use exact positive MAX IDs, comma separated.
PILOT_ALLOWED_MAX_IDS=
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
MAX_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
MAX_BOT_USERNAME=REPLACE_WITH_BOT_USERNAME
MAX_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
MAX_CA_FILE=private/max-ca.pem
PILOT_MAX_CA_FILE=./private/max-ca.pem
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_DELIVERY_ENABLED=false

# Product alerts retain their existing global setting and require account opt-in.
MAX_PRODUCT_NOTIFICATIONS_ENABLED=false

# Numeric MAX IDs of assigned moderators; public access does not grant this role.
# For a closed pilot also include these accounts in PILOT_ALLOWED_MAX_IDS.
# Empty disables moderator access. Demo accounts can never become moderators.
MODERATOR_MAX_IDS=
