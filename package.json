{
  "name": "max-educational-mutual-help",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @max-help/miniapp dev",
    "build": "pnpm --filter @max-help/contracts build && pnpm --filter @max-help/miniapp build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "integration": "node scripts/integration-test.mjs",
    "max:check": "node scripts/max-setup.mjs check",
    "max:commands": "node scripts/max-setup.mjs commands",
    "max:subscriptions": "node scripts/max-setup.mjs subscriptions",
    "max:subscribe": "node scripts/max-setup.mjs subscribe --confirm",
    "test:recovery": "node scripts/restart-test.mjs",
    "test:bot-mini": "node scripts/bot-mini-integration-test.mjs",
    "test:auth": "node scripts/auth-integration-test.mjs",
    "test:workflow": "node scripts/workflow-integration-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
